# Copy to .env and fill in. Never commit .env.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256

# development | production (production refuses to start without JWT_SECRET)
ENVIRONMENT=development

# Demo-only switches, off by default. Turn on for local research demos:
#   /graphql-insecure vulnerable baseline, and the dashboard's Layer 1/2 switches
#   (which apply to every user of the server).
ENABLE_INSECURE_BASELINE=false
ENABLE_LAYER_TOGGLE=false

# GraphQL limits
MAX_BATCH_OPERATIONS=5
MAX_QUERY_DEPTH=10
MAX_QUERY_ALIASES=15
MAX_QUERY_TOKENS=2000
ENABLE_INTROSPECTION=true
